font-size: 29px;
}
QCheckBox[qApp_deviceIsDragon=true] {
padding-left: 22px;
  padding-right: 22px;
}
QCheckBox[qApp_deviceIsDragon=true] {
spacing: 22px;
}
QCheckBox[localeName="ja"] {
font-family: Sans-SerifJP, sans-serif;
  font-style: normal;
}
QCheckBox[localeName="zh"] {
font-family: Sans-SerifZH-Simplified, sans-serif;
  font-style: normal;
}
