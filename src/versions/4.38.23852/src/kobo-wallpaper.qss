QSlider {
background-color: white;
}
QSlider[qApp_deviceIsDragon=true] {
min-height: 70px;
  max-height: 70px;
}
QSlider::groove:horizontal {
margin-left: 10px;
  margin-right: 10px;
  height: 1px;
  background-color: black;
}
QSlider[thickLineEnabled=true]::sub-page:horizontal {
margin-left: 10px;
  border-top: 3px solid black;
  border-bottom: 3px solid black;
}
QSlider[inverseThickLineEnabled=true]::add-page:horizontal {
margin-left: 10px;
  border-top: 3px solid black;
  border-bottom: 3px solid black;
}
QSlider::handle:horizontal {
image: url(:/images/reading/scrubber_handle_off.png);
  margin-left: -10px;
  margin-right: -10px;
}
QSlider::handle:horizontal[qApp_deviceIsDragon=true] {
width: 56px;
  height: 56px;
  margin-top: -28px;
  margin-bottom: -28px;
}
QSlider::handle:horizontal:pressed {
image: url(:/images/reading/scrubber_handle_hit.png);
  margin-left: -10px;
  margin-right: -10px;
}
QSlider::handle:horizontal:pressed[qApp_deviceIsDragon=true] {
width: 56px;
  height: 56px;
  margin-top: -28px;
  margin-bottom: -28px;
}
QSlider[noHandle=true]::handle:horizontal {
image: none;
  width: 0px;
  margin-left: 0px;
  margin-right: 0px;
}
QSlider[noHandle=true]::handle:horizontal:pressed {
image: none;
  width: 0px;
}
QScrollBar {
background: black;
}
QScrollBar[qApp_deviceIsDragon=true] {
max-width: 2px;
  min-width: 2px;
  margin: 16px;
}
QScrollBar::handle {
background: white;
}
QScrollBar::handle[qApp_deviceIsDragon=true] {
border: 2px solid black;
  max-width: 11px;
  min-width: 11px;
  min-height: 38px;
  border-radius: 5px;
}
QScrollBar::handle:pressed {
-qt-border-anti-alias: disabled;
  background: black;
}
QScrollBar::add-page,
QScrollBar::sub-page {
background: transparent;
}
QScrollBar::add-line,
QScrollBar::sub-line {
height: 0px;
  width: 0px;
}
